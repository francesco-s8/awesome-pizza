{
  "info": {
    "_postman_id": "d98e97a2-ff1f-4e16-a3e3-1d3fd22e5e56",
    "name": "Awesome Pizza API",
    "description": "Requests for all Awesome Pizza REST API endpoints. Update the collection variables to match your local server and resource IDs.",
